# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# --- AWS SSO OIDC settings (sensible defaults, usually no need to change) ---
AWS_REGION=us-east-1
CLIENT_NAME=Kiro Manager Lite

# Start URL for the device authorization flow.
# For AWS Builder ID leave this as the default below.
# For an IAM Identity Center org, set it to https://<your-subdomain>.awsapps.com/start
START_URL=https://view.awsapps.com/start

# Kiro Account Lite export metadata
KIRO_APP=kiro-account-lite
KIRO_VERSION=1.0.23

# Placeholder subscription metadata written into the export.
# These values are NOT returned by AWS - they are cosmetic fields the
# kiro-account-lite format expects. Set them to whatever your tooling needs.
SUB_TYPE=Pro_Max
SUB_TITLE=KIRO PRO MAX
SUB_RAW_TYPE=Q_DEVELOPER_STANDALONE_PRO_MAX
SUB_DAYS_REMAINING=8

# Placeholder profile ARN account id (the account id segment of profileArn).
PROFILE_ARN_ACCOUNT_ID=000000000000

# Optional: restrict the bot to specific Telegram user IDs (comma-separated).
# Leave empty to allow anyone who can message the bot.
ALLOWED_USER_IDS=
